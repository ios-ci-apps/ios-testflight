#!/usr/bin/env bash
# Archives an iOS app and uploads it to App Store Connect for TestFlight, signing through an
# App Store Connect API key: no Apple ID signed in to Xcode, no distribution certificate kept on
# the Mac. macOS with Xcode.
#
# Usage: testflight-upload --scheme <scheme> [--project-dir <dir>] [--project <x.xcodeproj> |
#          --workspace <x.xcworkspace>] [--configuration <name>] [--team-id <id>]
#          [--build-number <n>] --key-id <id> --issuer-id <id> [--key-path <AuthKey.p8>]
#          [--keychain-password-file <file>] [--output <dir>]
# The private key comes from --key-path or, preferably, the ASC_PRIVATE_KEY environment variable
# (the .p8 file's contents, e.g. from a GitHub secret). The variable is removed from the
# environment at once, so xcodegen, xcodebuild and build scripts don't inherit it; the key is
# written to a private temporary file just before archiving and removed on exit. It is never
# printed. xcodebuild must read that file, so code that runs during the build (Run Script phases,
# package plugins, xcodegen commands) runs as the same user and could read it too: build only
# code you trust.
# Without --output, the archive goes to a new folder under $RUNNER_TEMP. With --output, only the
# files this script writes there (App.xcarchive, ExportOptions.plist, export/) are replaced.
set -euo pipefail

die() { echo "testflight: $*" >&2; exit 1; }
log() { echo "testflight: $*" >&2; }

project_dir="$PWD" scheme="" project="" workspace="" configuration="Release" team_id=""
build_number="" key_id="${ASC_KEY_ID:-}" issuer_id="${ASC_ISSUER_ID:-}" key_path="${ASC_KEY_PATH:-}"
keychain_password_file="${KEYCHAIN_PASSWORD_FILE:-}" output=""
while (($#)); do
    case "$1" in
        --project-dir) project_dir="$2"; shift 2 ;;
        --scheme) scheme="$2"; shift 2 ;;
        --project) project="$2"; shift 2 ;;
        --workspace) workspace="$2"; shift 2 ;;
        --configuration) configuration="$2"; shift 2 ;;
        --team-id) team_id="$2"; shift 2 ;;
        --build-number) build_number="$2"; shift 2 ;;
        --key-id) key_id="$2"; shift 2 ;;
        --issuer-id) issuer_id="$2"; shift 2 ;;
        --key-path) key_path="$2"; shift 2 ;;
        --keychain-password-file) keychain_password_file="$2"; shift 2 ;;
        --output) output="$2"; shift 2 ;;
        -h|--help) sed -n '2,19p' "$0"; exit 0 ;;
        *) die "unknown argument $1" ;;
    esac
done

[[ -n "$scheme" ]] || die "--scheme is required"
# A scheme is a file name in the project: no slashes, control characters or leading dash.
[[ "$scheme" != -* && "$scheme" != *"/"* && "$scheme" != *[[:cntrl:]]* ]] \
    || die "--scheme should be a scheme name, without '/', control characters or a leading '-'"
[[ -n "$key_id" && -n "$issuer_id" ]] || die "an App Store Connect API key is required: --key-id and --issuer-id (or ASC_KEY_ID and ASC_ISSUER_ID)"
[[ "$key_id" =~ ^[A-Z0-9]{10}$ ]] || die "--key-id should be the 10-character Key ID from App Store Connect"
[[ "$issuer_id" =~ ^[0-9a-fA-F-]{36}$ ]] || die "--issuer-id should be the Issuer ID (a UUID) from App Store Connect"
[[ -z "$team_id" || "$team_id" =~ ^[A-Z0-9]{10}$ ]] || die "--team-id should be a 10-character team ID"
# A build number must grow with every upload. The default, the UTC time to the minute, always does.
: "${build_number:=$(date -u +%Y%m%d%H%M)}"
[[ "$build_number" =~ ^[0-9]+(\.[0-9]+){0,2}$ ]] || die "--build-number must be up to three dot-separated numbers"
[[ -z "$project" || -z "$workspace" ]] || die "pass --project or --workspace, not both"

# The API key: take it out of the environment before anything else runs. A shell variable that
# is not exported stays in this script.
private_key="${ASC_PRIVATE_KEY:-}"
unset ASC_PRIVATE_KEY
key_marker="-----BEGIN PRIVATE"" KEY-----"
if [[ -n "$private_key" ]]; then
    [[ "$private_key" == *"$key_marker"* ]] || die "ASC_PRIVATE_KEY is not a .p8 key"
elif [[ -n "$key_path" ]]; then
    [[ -f "$key_path" && -r "$key_path" ]] || die "private key file $key_path is not readable"
    grep -q -- "$key_marker" "$key_path" || die "private key file $key_path is not a .p8 key"
    key_path="$(cd "$(dirname "$key_path")" && pwd)/$(basename "$key_path")"
else
    die "no private key: set ASC_PRIVATE_KEY (the .p8 contents) or pass --key-path"
fi

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT
# Inputs never become part of a path that is deleted: the default folder is new, and with
# --output only this script's own files are removed.
if [[ -n "$output" ]]; then
    mkdir -p "$output"
    rm -rf "$output/App.xcarchive" "$output/export" "$output/ExportOptions.plist"
else
    output="$(mktemp -d "${RUNNER_TEMP:-$work}/testflight.XXXXXX")"
fi
output="$(cd "$output" && pwd)"

if [[ -n "$keychain_password_file" ]]; then
    # A runner service can find the login keychain locked; signing then fails with errSecInternalComponent.
    [[ -f "$keychain_password_file" && -r "$keychain_password_file" ]] || die "keychain password file $keychain_password_file is not readable"
    mode="$(stat -f %Lp "$keychain_password_file" 2>/dev/null || stat -c %a "$keychain_password_file")"
    [[ "$mode" =~ 00$ ]] || die "$keychain_password_file is readable by others; run: chmod 600 \"$keychain_password_file\""
    security unlock-keychain -p "$(< "$keychain_password_file")" "$HOME/Library/Keychains/login.keychain-db" > /dev/null 2>&1 \
        || die "could not unlock the login keychain with $keychain_password_file"
    log "unlocked the login keychain"
fi

cd "$project_dir"
if [[ -f project.yml ]] && command -v xcodegen > /dev/null; then
    xcodegen generate --quiet >&2
fi
container=()
if [[ -n "$workspace" ]]; then container=(-workspace "$workspace")
elif [[ -n "$project" ]]; then container=(-project "$project")
fi

# The key file exists only from here on, after xcodegen, for the two xcodebuild steps.
if [[ -n "$private_key" ]]; then
    key_path="$work/AuthKey_$key_id.p8"
    (umask 077 && printf '%s\n' "$private_key" > "$key_path")
    private_key=""
fi
auth=(-allowProvisioningUpdates -authenticationKeyPath "$key_path"
    -authenticationKeyID "$key_id" -authenticationKeyIssuerID "$issuer_id")
settings=("CURRENT_PROJECT_VERSION=$build_number")
[[ -n "$team_id" ]] && settings+=("DEVELOPMENT_TEAM=$team_id")

archive="$output/App.xcarchive"
log "archiving $scheme ($configuration), build $build_number${team_id:+, team $team_id}"
# ${arr[@]+...} because macOS /bin/bash 3.2 treats an empty array as unbound under set -u.
xcodebuild archive ${container[@]+"${container[@]}"} -scheme "$scheme" -configuration "$configuration" \
    -destination 'generic/platform=iOS' -archivePath "$archive" "${auth[@]}" "${settings[@]}" -quiet >&2

# The build number only reaches the app if Info.plist reads $(CURRENT_PROJECT_VERSION). Check it
# here, because App Store Connect would refuse a repeated build number only after the upload.
info="$(find "$archive/Products/Applications" -maxdepth 2 -name Info.plist -path '*.app/*' | head -n 1)"
[[ -n "$info" ]] || die "no app in the archive"
read -r version built <<< "$(python3 -c 'import plistlib,sys; p=plistlib.load(open(sys.argv[1],"rb")); print(p.get("CFBundleShortVersionString","?"), p.get("CFBundleVersion","?"))' "$info")"
[[ "$built" == "$build_number" ]] || die "the archived app has build number '$built', not $build_number: set CFBundleVersion to \$(CURRENT_PROJECT_VERSION) in its Info.plist"

options="$output/ExportOptions.plist"
python3 - "$options" "$team_id" <<'PY'
import plistlib, sys
path, team = sys.argv[1], sys.argv[2]
options = {
    "method": "app-store-connect",
    "destination": "upload",
    "signingStyle": "automatic",
    "uploadSymbols": True,
    # The build number was set above; don't let Xcode change it.
    "manageAppVersionAndBuildNumber": False,
}
if team:
    options["teamID"] = team
with open(path, "wb") as handle:
    plistlib.dump(options, handle)
PY

log "uploading $scheme $version ($build_number) to App Store Connect"
# Xcode's own error for a failed export is often just "Copy failed". The reason is in the
# distribution logs it writes under TMPDIR, so print the relevant lines when the export fails.
touch "$work/export-started"
status=0
xcodebuild -exportArchive -archivePath "$archive" -exportOptionsPlist "$options" \
    -exportPath "$output/export" "${auth[@]}" -quiet >&2 || status=$?
if ((status != 0)); then
    logs="$(find "${TMPDIR:-/tmp}" -maxdepth 1 -name '*.xcdistributionlogs' -newer "$work/export-started" 2> /dev/null | tail -n 1)"
    if [[ -n "$logs" ]]; then
        log "export failed; Xcode's distribution log ($logs) says:"
        # Errors from every log first, then the end of the main log, which names the failing step.
        grep -h -i -E 'error|fail|denied|not (found|available|allowed)|agreement' "$logs"/*.log 2> /dev/null | tail -n 40 >&2 || true
        echo "--- end of IDEDistribution.standard.log ---" >&2
        tail -n 40 "$logs/IDEDistribution.standard.log" >&2 2> /dev/null || true
    else
        log "export failed, and Xcode left no distribution log in ${TMPDIR:-/tmp}"
    fi
    exit "$status"
fi
log "uploaded; it appears in TestFlight once App Store Connect has processed it"

if [[ -n "${GITHUB_STEP_SUMMARY:-}" ]]; then
    {
        echo "### TestFlight upload"
        echo "- \`$scheme\` $version ($build_number)${team_id:+, team \`$team_id\`}"
        echo "- Shows in TestFlight once App Store Connect finishes processing (usually minutes)."
    } >> "$GITHUB_STEP_SUMMARY"
fi
echo "$version ($build_number)"
